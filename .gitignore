*.log
inventory/host_vars/mash.met.surf/vars.yml.backup
inventory/host_vars/*/vars.yml.pre-vault.bak
inventory/host_vars/*/vault.yml.bak

# ignore files created by running pre-commit locally
.ansible

# ignore roles pulled by ansible-galaxy
/roles/galaxy/*
!/roles/galaxy/.gitkeep

# ignores vscode file
.vscode

# ignores macos files
.DS_Store

# Ansible Vault password file (local only)
.vault-pass

/requirements.yml
/setup.yml
/group_vars/mash_servers

/run/*
!/run/.gitkeep

/var/
.direnv/
.envrc.local

/group_vars/*
!/group_vars/.gitkeep

# ignore Python bytecode caches (e.g. from running tests with `python -m unittest`)
__pycache__/

OC_URL={{ opencloud_url }}
OC_CONFIG_DIR=/etc/opencloud
OC_BASE_DATA_PATH=/var/lib/opencloud
PROXY_HTTP_ADDR=0.0.0.0:{{ opencloud_container_http_port }}
PROXY_TLS=false
OC_INSECURE=false
IDM_CREATE_DEMO_USERS=false
IDM_ADMIN_PASSWORD={{ opencloud_admin_password }}
OC_DEFAULT_LANGUAGE={{ opencloud_default_language }}
OC_LOG_LEVEL={{ opencloud_log_level }}
OC_LOG_COLOR=false
OC_LOG_PRETTY=false
PROXY_ENABLE_BASIC_AUTH=false
PROXY_CSP_CONFIG_FILE_LOCATION=/etc/opencloud/csp.yaml
OC_ADD_RUN_SERVICES={{ 'collaboration' if opencloud_collaboration_enabled else '' }}
{% if opencloud_collaboration_enabled %}
COLLABORATION_APP_NAME={{ opencloud_collaboration_app_name }}
COLLABORATION_APP_PRODUCT={{ opencloud_collaboration_app_product }}
COLLABORATION_APP_ADDR={{ opencloud_collaboration_app_url }}
COLLABORATION_APP_ICON={{ opencloud_collaboration_app_url }}/web-apps/apps/documenteditor/main/resources/img/favicon.ico
COLLABORATION_WOPI_SRC={{ opencloud_url }}
COLLABORATION_APP_INSECURE=false
COLLABORATION_CS3API_DATAGATEWAY_INSECURE=false
COLLABORATION_APP_PROOF_DISABLE={{ opencloud_collaboration_app_proof_disable | ternary('true', 'false') }}
{% endif %}
FRONTEND_FULL_TEXT_SEARCH_ENABLED={{ opencloud_search_enabled | ternary('true', 'false') }}
{% if opencloud_search_enabled %}
SEARCH_EXTRACTOR_TYPE=tika
SEARCH_EXTRACTOR_TIKA_TIKA_URL={{ opencloud_search_tika_url }}
{% endif %}
{% if opencloud_smtp_enabled %}
NOTIFICATIONS_SMTP_HOST={{ opencloud_smtp_host }}
NOTIFICATIONS_SMTP_PORT={{ opencloud_smtp_port }}
NOTIFICATIONS_SMTP_SENDER={{ opencloud_smtp_sender }}
NOTIFICATIONS_SMTP_USERNAME={{ opencloud_smtp_username }}
NOTIFICATIONS_SMTP_PASSWORD={{ opencloud_smtp_password }}
NOTIFICATIONS_SMTP_AUTHENTICATION={{ opencloud_smtp_authentication }}
NOTIFICATIONS_SMTP_ENCRYPTION={{ opencloud_smtp_encryption }}
NOTIFICATIONS_SMTP_INSECURE=false
{% endif %}
{{ opencloud_environment_variables_additional_variables }}
